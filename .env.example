# Site
NEXT_PUBLIC_SITE_URL=https://privatetransfergreece.com

# Supabase
# Project URL and anon key are safe to expose to the browser. The anon key
# is used for the admin login session, and (server-side only, via
# lib/supabase/public-client.ts) for public RLS-gated reads of published
# blog posts — never for leads/drivers/invoices or any other table.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. NEVER prefix with NEXT_PUBLIC_. Used exclusively in server
# code (Server Actions, Route Handlers) to read/write application data.
SUPABASE_SERVICE_ROLE_KEY=

# Blog author — a real Supabase Auth user UUID (Authentication > Users),
# created the same way as the admin account. Required by scripts/seed-blog.mjs.
# See supabase/migrations/README.md.
BLOG_AUTHOR_ID=

# Email (Resend)
RESEND_API_KEY=
# Verified sending address on your Resend domain, e.g. bookings@privatetransfergreece.com
FROM_EMAIL=
# Inbox that receives new quote request notifications
ADMIN_EMAIL=
# Address customers land on if they hit Reply on an admin-composed email
# (falls back to ADMIN_EMAIL if unset)
REPLY_TO_EMAIL=

# Optional: forward every new quote request to a webhook (e.g. Slack, Zapier)
QUOTE_NOTIFICATION_WEBHOOK_URL=
